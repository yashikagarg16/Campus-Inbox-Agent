# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: low | medium | high (default: the model's default, medium)
GEMINI_THINKING_LEVEL=
DATABASE_URL=sqlite:///./campus_inbox.db
# PostgreSQL example: postgresql://user:password@localhost:5432/campus_inbox
CORS_ORIGINS=http://localhost:5173

# Optional: require "Authorization: Bearer <token>" on every endpoint except /health.
# Set this on any server reachable from the internet.
APP_TOKEN=

# Optional: read-only inbox sync. For Gmail use imap.gmail.com and an app password.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SENDER_FILTER=

# Optional: read-only Outlook / Microsoft 365 (college accounts). IMAP passwords don't work there.
# Register an app (see README, "Outlook / Microsoft 365") and paste its Application (client) ID.
MS_CLIENT_ID=
MS_TENANT=organizations
# Optional: model to use if GEMINI_MODEL stays overloaded after retries
GEMINI_FALLBACK_MODEL=

# Optional: owner sign-in. Make the hash with `python -m tools.hash_password`.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Public read-only demo (seeds synthetic emails, rejects writes). Leave unset for normal use.
DEMO_MODE=false
